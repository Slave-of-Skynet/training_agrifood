# Smart Harvest Environment Configuration Template
# Copy or adapt these settings for local execution.
# Note: Paths assume backend launch from the repository root.

# --- Backend Mode B Runtime Settings (Required for dataset-backed analytics) ---
SMART_HARVEST_DATA_DIR=sponsor_pack/data
SMART_HARVEST_BASELINE_ARTIFACT=backend/artifacts/baseline-crop-median-v1-p1-s2024.json

# --- Frontend API Origin (Optional) ---
# When empty, Vite dev proxy routes `/api` requests to http://localhost:8000.
# For production-build preview or direct local API access, set to http://127.0.0.1:8000
VITE_API_BASE_URL=

# --- Backend CORS Allowed Origins (Optional) ---
# Comma-separated list of origins permitted to call the backend.
# Default if unset: http://localhost:5173
# For preview server fallback, add or use: http://127.0.0.1:4173
SMART_HARVEST_CORS_ORIGINS=http://localhost:5173
